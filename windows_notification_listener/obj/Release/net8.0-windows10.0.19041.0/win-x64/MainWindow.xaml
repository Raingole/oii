<Window
    x:Class="WindowsNotificationListener.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="10" Padding="20">
        <TextBlock Text="Windows 通知监听器 · 阶段 1" FontSize="22" />
        <TextBlock Text="只读取 Toast 通知，不连接服务器。" />
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:ConnectionId='4' x:Name="RequestButton" Content="请求通知权限"                             />
            <Button x:ConnectionId='5' x:Name="StartButton" Content="开始监听"                           IsEnabled="False" />
            <Button x:ConnectionId='6' Content="停止监听"                          />
        </StackPanel>
        <TextBlock x:ConnectionId='2' x:Name="StatusText" Text="状态：未授权" />
        <TextBox x:ConnectionId='3' x:Name="Output" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="300" />
    </StackPanel>
</Window>

