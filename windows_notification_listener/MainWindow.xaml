<Window
    x:Class="WindowsNotificationListener.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="10" Padding="20">
        <TextBlock Text="Windows 通知监听器 · 阶段 2" FontSize="22" />
        <TextBlock Text="读取 Toast 通知并通过 WebSocket 推送到服务器。" />
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="RequestButton" Content="请求通知权限" Click="RequestButton_Click" />
            <Button x:Name="StartButton" Content="开始监听" Click="StartButton_Click" IsEnabled="False" />
            <Button Content="停止监听" Click="StopButton_Click" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Text="状态：未授权" />
        <TextBox x:Name="ServerUrlBox" Header="服务器 WS 地址" PlaceholderText="ws://127.0.0.1:8005/ws/windows" />
        <TextBox x:Name="DeviceIdBox" Header="设备 ID" PlaceholderText="windows-pc-001" />
        <PasswordBox x:Name="TokenBox" Header="令牌" />
        <TextBox x:Name="Output" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="220" />
    </StackPanel>
</Window>
